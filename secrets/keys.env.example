# 이 파일은 예시입니다. 실제 값은 같은 폴더의 keys.env 로 복사해서 채우세요.
#   cp secrets/keys.env.example secrets/keys.env
# keys.env 는 .gitignore 로 커밋이 막혀 있습니다.
# 이 값들은 Apps Script 의 "스크립트 속성"에 입력하기 위한 보관용 메모입니다 (코드는 이 파일을 읽지 않습니다).

# 네이버 검색광고 API (광고주센터 > 광고 시스템 > 도구 > API 사용 관리)
NAVER_API_KEY=
NAVER_SECRET_KEY=
NAVER_CUSTOMER_ID=

# Claude API 키 (Anthropic 콘솔에서 발급)
CLAUDE_API_KEY=
